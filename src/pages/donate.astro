---
import BaseLayout from '../layouts/BaseLayout.astro';
import DonateHero from '../components/donate/DonateHero.astro';
import DonateImpactIntro from '../components/donate/DonateImpactIntro.astro';
import MissionBand from '../components/global/MissionBand.astro';
import CtaBand from '../components/global/CtaBand.astro';
import Story from '../components/home/Story.astro';
---

<BaseLayout
  title="Donate to Support Our Mission"
  description="Your donation helps fund health, education, and nutrition programs for families in Veracruz, Mexico. Give today and support Elva's lasting legacy."
  headerTheme="light"
>
  <DonateHero />
  <DonateImpactIntro />
  <MissionBand
    sectionBg="bg-orchid-050"
    ctaTitle="Where the impact happens"
    ctaBody="See the programs your donation directly supports."
    primaryLabel="Explore"
    primaryHref="/programs"
  />
  {/* Figma 3315:18777 — CtaBand; título/CTA = defaults Home; body = 1 parágrafo do Figma Donate. */}
  <CtaBand
    body={[
      'Sharing what life has taught you through action, presence, and generosity means joining a movement that builds, heals, and uplifts communities.',
    ]}
  />
  {/* Figma 3315:18816 — mesma estrutura de Story (Home); copy + foto de Sponsorship. */}
  <Story
    eyebrow="Sponsorship"
    titleLines={['Every sponsor is a', 'seed of change.']}
    body="Let’s build something meaningful together. Get in touch to explore partnership opportunities, whether co-creating a program or supporting an existing initiative."
    image="/images/donate/sponsorship.webp"
    imageAlt="A community sponsor wearing a red cap outdoors"
    imagePosition="50% 18%"
    cta={{ label: 'Send a message', href: '/contact' }}
  />
</BaseLayout>
