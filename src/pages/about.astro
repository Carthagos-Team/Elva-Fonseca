---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/global/Hero.astro';
import LegacyStory from '../components/about/LegacyStory.astro';
import Story from '../components/about/Story.astro';
import CtaDonate from '../components/global/CtaDonate.astro';
import Team from '../components/about/Team.astro';
import CtaBand from '../components/global/CtaBand.astro';
---

<BaseLayout
  title="Our Story & Mission in Veracruz"
  description="Discover the story of Elva Fonseca and how her legacy of compassion shaped a foundation dedicated to serving communities across Veracruz, Mexico."
  headerTheme="light"
>
  <Hero
    titleLines={['A story of care']}
    subcopy={[
      'Fundación Elva Fonseca is a nonprofit organization working to support vulnerable communities, especially in rural areas of Veracruz, Mexico.',
      'We lead initiatives focused on health, education, environmental care, women’s empowerment, and child development, always with a human-centered approach.',
    ]}
    image="/images/hero/about.webp"
    imageAlt="A person loading flatbreads into a traditional wood-fired oven"
    cta={{ label: 'Learn more', href: '#story' }}
  />

  <LegacyStory />

  <Story />

  {/* Figma 3288:321 — mesma estrutura de CtaDonate; só troca de copy nesta instância. */}
  <CtaDonate
    titleLines={['Our mission']}
    body="With empathy and open hands, we work to ensure that no one is left behind. Our goal is to stand beside those who need it, offering care, resources, and dignity to the most vulnerable members of our community."
  />

  <Team />

  {/* Figma 3292:493 — CtaBand; só troca de copy nesta instância. */}
  <CtaBand
    titleLines={['Ready to lend a hand?']}
    body={[
      "Your support helps us keep Elva's legacy alive, turning compassion into action, and small gestures into lasting change. Every contribution helps nourish, educate, and uplift those who need it most.",
    ]}
    ctaLabel="Donate Now"
    ctaHref="/donate"
    secondaryLabel="Volunteer"
    secondaryHref="/volunteer"
  />
</BaseLayout>
