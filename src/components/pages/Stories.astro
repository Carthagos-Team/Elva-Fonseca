---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLang, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t.stories.seo.title} description={t.stories.seo.description}>
  <section class="px-10 py-20">
    <h1 class="font-display text-4xl">{t.stories.heading}</h1>
    <p class="mt-4 max-w-prose text-ink/70">{t.stories.body}</p>
  </section>
</BaseLayout>
