---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../global/Hero.astro';
import Intro from '../volunteer/Intro.astro';
import StepTimeline from '../volunteer/StepTimeline.astro';
import VolunteerForm from '../volunteer/VolunteerForm.astro';
import { defaultLang, useTranslations, type Lang } from '../../i18n/utils';
import { HERO_IMAGES } from '../../lib/hero-images';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t.volunteer.seo.title}
  description={t.volunteer.seo.description}
  headerTheme="light"
  lcpImage={HERO_IMAGES.volunteer.src}
>
  <Hero
    titleLines={t.volunteer.hero.titleLines}
    subcopy={t.volunteer.hero.subcopy}
    image={HERO_IMAGES.volunteer.src}
    imageAlt={t.volunteer.hero.imageAlt}
  />

  <Intro lang={lang} />

  <StepTimeline lang={lang} />

  <VolunteerForm lang={lang} />
</BaseLayout>
