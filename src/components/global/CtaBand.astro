---
// CtaBand — Fase 2/3. Banda de CTA reutilizável (acima do footer, repete em várias páginas).
// Fiel ao Figma "volunteer-cta" (node 3098:2384). Conteúdo via props; default = volunteer.
// Thank You (3073:72): props opcionais receipt / prompt / secondaryAction="share".
//
// Flores laterais = elementos DOM individuais (classe .cta-petal), NUNCA imagem única.
// Estruturadas para o reveal em stagger com GSAP ScrollTrigger que entra na FASE 5
// (ver src/lib/gsap.ts / createMotion). Por ora renderizam estáticas/visíveis.

interface Props {
  titleLines?: readonly string[];
  body?: readonly string[];
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  /** Thank You: linha de confirmação com ícone check */
  receipt?: string;
  /** Texto acima da row de botões (ex.: "Want to do even more?") */
  prompt?: string;
  /** Quando 'share', secondary vira botão Web Share (fallback: copiar URL) */
  secondaryAction?: 'share';
}

const {
  titleLines = ['As a volunteer,', 'you can make a difference.'],
  body = [
    'There is wisdom in every hand and strength in every gesture. By offering your time and choosing to care, you become part of something greater.',
    'Sharing what life has taught you through action, presence, and generosity means joining a movement that builds, heals, and\u00A0uplifts\u00A0communities.',
  ],
  ctaLabel = 'Apply for Volunteering',
  ctaHref = '/volunteer#apply',
  secondaryLabel,
  secondaryHref,
  receipt,
  prompt,
  secondaryAction,
} = Astro.props;

const isThankYou = Boolean(receipt);
const showSecondaryLink = Boolean(secondaryLabel && secondaryHref && secondaryAction !== 'share');
const showSecondaryShare = Boolean(secondaryLabel && secondaryAction === 'share');

const btnSecondary =
  'inline-flex min-h-11 items-center justify-center rounded-md border-[1.5px] border-woodsmoke bg-surface px-6 py-3.5 font-display font-black text-base uppercase tracking-[-0.01em] text-ink transition-[transform,filter] duration-150 ease-out hover:brightness-95 active:scale-[0.97]';

// Flores do cluster (posições em % da caixa 601.6×591 do Figma). Ordem = de baixo p/ cima,
// pensada para o stagger da Fase 5. `mobile` marca as que sobrevivem abaixo de sm (densidade reduzida).
const flowers = [
  { tex: '07', x: 0, y: 78.1, w: 23.7 },
  { tex: '01', x: 19.4, y: 78.1, w: 23.7 },
  { tex: '04', x: 38.9, y: 78.1, w: 23.7 },
  { tex: '06', x: 58.6, y: 78.1, w: 23.7 },
  { tex: '02', x: 77.8, y: 78.1, w: 23.7 },
  { tex: '03', x: 19.4, y: 58.2, w: 23.7 },
  { tex: '01', x: 77.8, y: 58.2, w: 23.7 },
  { tex: '07', x: 35.3, y: 35.1, w: 50.4, mobile: true },
  { tex: '05', x: 77.8, y: 38.5, w: 23.7 },
  { tex: '05', x: 42.1, y: 18.4, w: 23.7 },
  { tex: '04', x: 58.6, y: 0, w: 45.5, mobile: true },
];
---

<section
  data-cta-band
  data-cta-band-reveal
  class:list={[
    'relative isolate overflow-clip px-6 pb-40 pt-14 text-center sm:px-10 lg:px-16 lg:pb-52 lg:pt-20',
    isThankYou ? 'bg-orchid-100' : 'border-t border-woodsmoke/8 bg-surface',
  ]}
>
  {/* Clusters de flores (decorativos). Cada .cta-petal é individual → stagger na Fase 5. */}
  {
    (['left', 'right'] as const).map((side) => (
      <div
        class:list={[
          // translate-y-[20%]: no Figma o cluster atravessa a borda inferior (~119/591px clipados)
          'cta-flowers pointer-events-none absolute bottom-0 z-0 aspect-[601.6/591] w-[42vw] max-w-[37.6rem] translate-y-[20%]',
          side === 'left' ? '-left-[4.6vw] -scale-x-100' : '-right-[4.6vw]',
        ]}
        data-side={side}
        aria-hidden="true"
      >
        {flowers.map((f) => (
          <img
            src={`/images/cta/flower-${f.tex}.webp`}
            alt=""
            loading="lazy"
            decoding="async"
            class:list={['cta-petal absolute', !f.mobile && 'hidden sm:block']}
            style={`left:${f.x}%;top:${f.y}%;width:${f.w}%`}
            data-reveal="petal"
          />
        ))}
      </div>
    ))
  }

  {/* Conteúdo */}
  <div data-cta-band-content class="relative z-10 mx-auto flex max-w-[75rem] flex-col items-center gap-8 lg:gap-12">
    <img src="/images/cta/rose.svg" alt="" aria-hidden="true" width="68" height="64" class="w-[4.25rem]" />

    <div class="flex flex-col items-center gap-6">
      <h2 class="font-display font-black text-[2.5rem] uppercase leading-none tracking-[-0.04em] text-ink sm:text-6xl lg:text-[4.5rem]">
        {titleLines.map((line, i) => (
          <>
            {line}
            {i < titleLines.length - 1 && <br />}
          </>
        ))}
      </h2>

      <div class="flex max-w-[34rem] flex-col gap-4 text-ink/85">
        {body.map((p) => <p class="text-base font-medium leading-relaxed tracking-[-0.01em]">{p}</p>)}
      </div>

      {
        receipt && (
          <p class="flex items-center justify-center gap-3 font-sans text-sm font-semibold uppercase leading-[1.4] text-ink">
            <img
              src="/images/cta/check-circle.svg"
              alt=""
              width="16"
              height="16"
              class="size-4 shrink-0"
              aria-hidden="true"
            />
            {receipt}
          </p>
        )
      }
    </div>

    <div class="flex flex-col items-center gap-6">
      {prompt && <p class="max-w-[34rem] text-base font-medium leading-relaxed tracking-[-0.02em] text-ink">{prompt}</p>}

      <div class="flex flex-col items-center gap-3 sm:flex-row sm:gap-3">
        <a
          href={ctaHref}
          class="hover-text inline-flex min-h-11 items-center justify-center rounded-md border-[1.5px] border-woodsmoke bg-buckthorn px-6 py-3.5 font-display font-black text-base uppercase tracking-[-0.01em] text-ink transition-[transform,filter] duration-150 ease-out hover:brightness-105 active:scale-[0.97]"
        >
          <span class="hover-text__inner">
            <span class="hover-text__label is--default" data-hover-text-el>{ctaLabel}</span>
            <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{ctaLabel}</span>
          </span>
        </a>
        {
          showSecondaryLink && (
            <a href={secondaryHref} class={`hover-text ${btnSecondary}`}>
              <span class="hover-text__inner">
                <span class="hover-text__label is--default" data-hover-text-el>{secondaryLabel}</span>
                <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{secondaryLabel}</span>
              </span>
            </a>
          )
        }
        {
          showSecondaryShare && (
            <button type="button" data-cta-share class={`hover-text ${btnSecondary}`}>
              <span class="hover-text__inner">
                <span class="hover-text__label is--default" data-hover-text-el>{secondaryLabel}</span>
                <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{secondaryLabel}</span>
              </span>
            </button>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { createMotion, gsap } from '../../lib/gsap';

  function initCtaBand() {
    const section = document.querySelector<HTMLElement>('[data-cta-band-reveal]');
    if (!section) return;
    const petals = Array.from(section.querySelectorAll<HTMLElement>('[data-reveal="petal"]'));
    const content = section.querySelector<HTMLElement>('[data-cta-band-content]');

    createMotion(section, (ctx) => {
      if (ctx.reducedMotion) {
        gsap.set(petals, { clearProps: 'all' });
        if (content) gsap.set(content.children, { clearProps: 'all' });
        return;
      }

      const petalsTween = gsap.from(petals, {
        autoAlpha: 0,
        y: 16,
        scale: 0.9,
        duration: 0.5,
        ease: 'back.out(1.6)',
        stagger: 0.04,
        scrollTrigger: { trigger: section, start: 'top 70%', once: true },
      });

      const contentTween = content
        ? gsap.from(content.children, {
            y: 24,
            autoAlpha: 0,
            duration: 0.6,
            ease: 'power3.out',
            stagger: 0.12,
            scrollTrigger: { trigger: section, start: 'top 65%', once: true },
          })
        : null;

      return () => {
        [petalsTween, contentTween].forEach((t) => {
          t?.scrollTrigger?.kill();
          t?.kill();
        });
        gsap.set(petals, { clearProps: 'all' });
        if (content) gsap.set(content.children, { clearProps: 'all' });
      };
    });
  }

  if (document.readyState !== 'loading') initCtaBand();
  else document.addEventListener('DOMContentLoaded', initCtaBand);
</script>

{
  showSecondaryShare && (
    <script>
      const btn = document.querySelector('[data-cta-share]');
      if (btn instanceof HTMLButtonElement) {
        // Atualiza o texto das camadas do hover-text em vez do botão inteiro,
        // pra não apagar a estrutura de spans que o flip de hover depende.
        const labels = btn.querySelectorAll('[data-hover-text-el]');
        btn.addEventListener('click', async () => {
          const url = window.location.origin + '/';
          const title = 'Fundación Elva Fonseca';
          const text = "Support Elva Fonseca's mission of care and community.";
          try {
            if (navigator.share) {
              await navigator.share({ title, text, url });
              return;
            }
          } catch {
            /* user cancelled share — no-op */
            return;
          }
          try {
            await navigator.clipboard.writeText(url);
            const prev = labels[0]?.textContent ?? '';
            labels.forEach((el) => (el.textContent = 'Link copied'));
            window.setTimeout(() => {
              labels.forEach((el) => (el.textContent = prev));
            }, 2000);
          } catch {
            /* clipboard unavailable */
          }
        });
      }
    </script>
  )
}
