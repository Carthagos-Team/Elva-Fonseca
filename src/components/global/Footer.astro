---
// Footer — Fase 2. Fiel ao Figma Home (node 3089:2), responsivo desktop/tablet/mobile.
// Conteúdo hardcoded aqui; Fase 4 troca por siteSettings do Sanity (nav, donateUrl, legal, social).

import { defaultLang, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === defaultLang ? '' : `/${lang}`;

const nav = [
  { href: `${prefix}/`, label: t.common.footer.nav.home },
  { href: `${prefix}/about`, label: t.common.footer.nav.about },
  { href: `${prefix}/programs`, label: t.common.footer.nav.programs },
  { href: `${prefix}/volunteer`, label: t.common.footer.nav.volunteer },
  { href: `${prefix}/donate`, label: t.common.footer.nav.donate },
  { href: `${prefix}/contact`, label: t.common.footer.nav.contact },
];

const legal = [
  { href: `${prefix}/privacy`, label: t.common.footer.legal.privacy },
  { href: `${prefix}/terms`, label: t.common.footer.legal.terms },
];

const donateUrl = `${prefix}/donate`; // Fase 4: siteSettings.donateUrl (provedor externo)
const year = new Date().getFullYear();

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<footer class="relative overflow-hidden bg-brand text-orchid">
  {/* Papel picado — faixa decorativa topo */}
  <div class="papel papel--top" aria-hidden="true"></div>

  <div
    class="relative z-10 mx-auto grid max-w-[120rem] grid-cols-1 gap-x-16 gap-y-12 px-6 pb-24 pt-28 sm:px-10 lg:grid-cols-2 lg:items-end lg:px-[3.875rem] lg:pb-28 lg:pt-36"
  >
    {/* Logo */}
    <div class="lg:self-center">
      <img
        src="/images/footer/logo.svg"
        alt="La Mano Solidária — Elva Fonseca Foundation"
        width="632"
        height="472"
        class="h-auto w-48 md:w-64 lg:w-[28rem]"
      />
    </div>

    {/* Bloco direito: nav → título → (botão donate mobile) → legal */}
    <div class="flex flex-col items-start gap-8">
      <nav aria-label="Footer">
        <ul class="grid grid-flow-col grid-rows-3 gap-x-8 gap-y-1.5 sm:gap-x-12 lg:gap-x-16">
          {
            nav.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  aria-current={isCurrent(href) ? 'page' : undefined}
                  class="footer-navlink hover-text inline-flex py-2 font-display text-2xl uppercase tracking-[-0.04em] aria-[current=page]:opacity-60"
                >
                  <span class="hover-text__inner">
                    <span class="hover-text__label is--default" data-hover-text-el>{label}</span>
                    <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{label}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="font-display font-black text-[2.75rem] leading-none tracking-[-0.04em] sm:text-6xl lg:text-[5.75rem]">
        LA MANO<br />SOLIDÁRIA.
      </p>

      {/* CTA Donate — mobile (a aba vertical some abaixo de md) */}
      <a
        href={donateUrl}
        class="hover-text flex min-h-11 w-full items-center justify-center rounded-md bg-orchid px-6 py-3 font-display text-lg uppercase tracking-[-0.02em] text-jacko-bean-950 transition-opacity hover:opacity-90 md:hidden"
      >
        <span class="hover-text__inner">
          <span class="hover-text__label is--default" data-hover-text-el>{t.common.footer.donateLabel}</span>
          <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{t.common.footer.donateLabel}</span>
        </span>
      </a>

      {/* Linha legal + crédito */}
      <div class="flex flex-col items-start gap-y-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {
            legal.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  class="footer-legal hover-text text-[0.9375rem] font-semibold"
                >
                  <span class="hover-text__inner">
                    <span class="hover-text__label is--default" data-hover-text-el>{label}</span>
                    <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{label}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="https://carthagos.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hover-text inline-flex items-center gap-2 text-[0.9375rem]"
        >
          <span class="hover-text__inner opacity-80">
            <span class="hover-text__label is--default" data-hover-text-el>{t.common.footer.credit}</span>
            <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{t.common.footer.credit}</span>
          </span>
          <img src="/images/footer/crt.svg" alt="Carthagos" width="62" height="18" class="h-[1.1em] w-auto" />
        </a>
      </div>
    </div>
  </div>

  {/* Papel picado — faixa decorativa base */}
  <div class="papel papel--bottom" aria-hidden="true"></div>

  {/* Aba vertical Donate — desktop/tablet (md+); no mobile vira o botão acima.
      Gatilho do modal (QR Givebutter + compartilhar no WhatsApp), não navega mais
      direto pra /donate. Também é o elemento flutuante global — ver <script> abaixo:
      some dentro da hero e, ao passar dela, fica position:fixed permanentemente
      pelo resto do scroll da página (nunca volta a ser um elemento parado aqui
      dentro do footer). */}
  <button
    type="button"
    data-donate-modal-toggle
    aria-haspopup="dialog"
    aria-label={t.common.footer.donateLabel}
    class="donate-tab hidden md:flex"
  >
    <span class="donate-tab__text">{t.common.footer.donateLabel}</span>
  </button>

  <p class="sr-only">© {year} Elva Fonseca Foundation</p>
</footer>

<style>
  .papel {
    position: absolute;
    left: 0;
    right: 0;
    height: 3rem;
    background-image: url('/images/footer/papel-picado.webp');
    background-repeat: repeat-x;
    background-size: auto 100%;
    pointer-events: none;
  }
  .papel--top {
    top: 0;
    background-position: left top;
  }
  .papel--bottom {
    bottom: 0;
    background-position: left bottom;
    transform: scaleY(-1);
  }
  @media (min-width: 768px) {
    .papel { height: 4rem; }
  }
  @media (min-width: 1024px) {
    .papel { height: 5rem; }
  }

  /* Aba vertical (borda direita, centrada) */
  .donate-tab {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 0.625rem;
    border-top-left-radius: var(--radius-md);
    border-bottom-left-radius: var(--radius-md);
    background: var(--color-buckthorn);
    color: var(--color-jacko-bean-950);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1rem;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    transition: padding-right 0.2s ease, opacity 0.25s ease;
  }
  .donate-tab:hover {
    padding-right: 0.875rem;
  }
  .donate-tab__text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  /* .donate-tab é um <button> agora — zera reset de UA (borda, cursor, font herdada). */
  .donate-tab {
    border: none;
    cursor: pointer;
  }

  /* Estado flutuante global — ver <script> abaixo. Uma vez que a página passa da
     hero, a aba fica permanentemente position:fixed (nunca "pousa" de volta no
     footer) — só alterna is-visible ao entrar/sair da hero. A regra .donate-tab
     acima (position:absolute) só é relevante no instante antes do script rodar. */
  .donate-tab.is-floating {
    position: fixed;
    top: 50%;
    right: 0;
    transform: translateY(-50%) translateX(6em);
    opacity: 0;
    pointer-events: none;
    transition:
      padding-right 0.2s ease,
      opacity 0.25s ease,
      transform 0.6s cubic-bezier(0.625, 0.05, 0, 1);
  }
  .donate-tab.is-floating.is-visible {
    transform: translateY(-50%) translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .donate-tab,
    .donate-tab.is-floating {
      transition: none;
    }
  }
</style>

<script>
  // Aba Donate flutuante global — a MESMA aba do footer alterna entre "flutuando"
  // (position:fixed). Uma vez que passa da hero, fica flutuando permanentemente
  // até o fim da página — nunca "pousa" de volta no footer.
  import { createMotion, ScrollTrigger } from '../../lib/gsap';

  function initDonateTabFloat() {
    const tab = document.querySelector<HTMLElement>('[data-donate-modal-toggle].donate-tab');
    if (!tab) return;

    const heroEl = document.querySelector<HTMLElement>('[data-hero], [data-contact-hero]');

    // Página sem hero (ex.: Stories, ainda placeholder) — aba já nasce flutuando.
    if (!heroEl) {
      tab.classList.add('is-floating', 'is-visible');
      return;
    }

    createMotion(undefined, () => {
      // A diferença de reduced-motion já é resolvida via CSS (transition: none);
      // a lógica de mostrar/esconder é idêntica nos dois casos.
      const heroTrigger = ScrollTrigger.create({
        trigger: heroEl,
        start: 'bottom top',
        onEnter: () => tab.classList.add('is-floating', 'is-visible'),
        onLeaveBack: () => tab.classList.remove('is-visible'),
      });

      // createMotion reavalia este callback quando um breakpoint (isDesktop/
      // isMobile/reducedMotion) muda — sem matar o trigger antigo aqui, um
      // resize cruzando 1024px duplicaria o ScrollTrigger.
      return () => {
        heroTrigger.kill();
      };
    });
  }

  if (document.readyState !== 'loading') initDonateTabFloat();
  else document.addEventListener('DOMContentLoaded', initDonateTabFloat);
</script>
