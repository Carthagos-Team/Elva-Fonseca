---
// CtaVolunteer — banda CTA de 2 colunas (painel punch + foto). Fiel ao Figma (node 3139:282).
// Família dos CtaDonate/CtaBand; reutilizável. Estático; hook data-reveal-section p/ motion.

interface Props {
  titleLines?: readonly string[];
  subcopy?: string;
  image?: string;
  imageAlt?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string } | null;
}

const {
  titleLines = ['There are many ways', 'to make a difference.'],
  subcopy = "Whether donating, volunteering, or sharing our message, you are part of something greater. Help us continue Elva's legacy of compassion and service.",
  image = '/images/cta/volunteer.webp',
  imageAlt = 'A young girl standing in a doorway, holding a doll',
  primary = { label: 'Donate now', href: '/donate' },
  secondary = { label: 'Become a volunteer', href: '/volunteer' },
} = Astro.props;

const btnBase =
  'inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-md border-[1.5px] border-woodsmoke px-6 py-3.5 font-display font-black text-base uppercase tracking-[-0.01em] transition-[transform,filter] duration-150 ease-out active:scale-[0.97]';
---

<section data-reveal-section data-cta-volunteer class="border-t border-orchid-200 bg-surface">
  <div class="mx-auto max-w-[120rem] px-6 py-12 sm:px-10 sm:py-16 lg:px-16">
    <div class="grid overflow-hidden rounded-xl border-[1.5px] border-woodsmoke bg-brand lg:grid-cols-2 lg:h-130">
      {/* Conteúdo */}
      <div data-cta-volunteer-content class="flex flex-col justify-between gap-10 p-8 sm:p-12">
        <div class="flex flex-col gap-6">
          <h2 class="font-display font-black uppercase leading-none tracking-[-0.04em] text-orchid text-[1.75rem] sm:text-4xl lg:text-[2.5rem] min-[1300px]:text-[3.25rem]">
            {
              titleLines.map((line, i) => (
                <>
                  {line}
                  {i < titleLines.length - 1 && <br />}
                </>
              ))
            }
          </h2>
          <p class="max-w-[34rem] font-sans text-lg font-normal leading-relaxed text-orchid/85">
            {subcopy}
          </p>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row sm:gap-5">
          <a href={primary.href} class={`hover-text ${btnBase} bg-buckthorn text-ink hover:brightness-105`}>
            <span class="hover-text__inner">
              <span class="hover-text__label is--default" data-hover-text-el>{primary.label}</span>
              <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{primary.label}</span>
            </span>
          </a>
          {secondary && (
            <a href={secondary.href} class={`hover-text ${btnBase} bg-orchid text-ink hover:brightness-105`}>
              <span class="hover-text__inner">
                <span class="hover-text__label is--default" data-hover-text-el>{secondary.label}</span>
                <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{secondary.label}</span>
              </span>
            </a>
          )}
        </div>
      </div>

      {/* Foto — absolute em lg p/ não esticar o grid; aspect só abaixo de lg.
          Object-position: 28% mobile/tablet (crop aprovado); 20% desktop (inalterado). */}
      <div data-cta-volunteer-photo class="relative aspect-[4/5] w-full overflow-hidden sm:aspect-[5/6] lg:aspect-auto lg:h-auto">
        <img
          src={image}
          alt={imageAlt}
          width="1312"
          height="1040"
          class="absolute inset-0 h-full w-full object-cover object-[50%_28%] lg:object-[50%_20%]"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { createMotion, gsap } from '../../lib/gsap';

  function initCtaVolunteer() {
    const section = document.querySelector<HTMLElement>('[data-cta-volunteer]');
    if (!section) return;
    const slots = [
      section.querySelector<HTMLElement>('[data-cta-volunteer-content]'),
      section.querySelector<HTMLElement>('[data-cta-volunteer-photo]'),
    ].filter((el): el is HTMLElement => !!el);
    if (!slots.length) return;

    createMotion(section, (ctx) => {
      if (ctx.reducedMotion) {
        gsap.set(slots, { clearProps: 'all' });
        return;
      }

      const tween = gsap.from(slots, {
        y: 24,
        autoAlpha: 0,
        duration: 0.6,
        ease: 'power3.out',
        stagger: 0.12,
        scrollTrigger: { trigger: section, start: 'top 65%', once: true },
      });

      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        gsap.set(slots, { clearProps: 'all' });
      };
    });
  }

  if (document.readyState !== 'loading') initCtaVolunteer();
  else document.addEventListener('DOMContentLoaded', initCtaVolunteer);
</script>
