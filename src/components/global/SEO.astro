---
import { defaultLang, getRouteFromUrl, type Lang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const { lang = defaultLang, title, description, ogImage = '/og-default.jpg', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = `${title} — Elva Fonseca Foundation`;
const ogImageUrl = new URL(ogImage, Astro.site);
const enHref = new URL(getRouteFromUrl(Astro.url, 'en'), Astro.site);
const esHref = new URL(getRouteFromUrl(Astro.url, 'es'), Astro.site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'Elva Fonseca Foundation',
  alternateName: 'Fundación Elva Fonseca',
  url: Astro.site?.toString(),
  logo: new URL('/images/brand/logo-lockup-dark.svg', Astro.site).toString(),
  description:
    'Nonprofit foundation supporting health, education, nutrition, and community programs for vulnerable families in Veracruz, Mexico.',
  areaServed: { '@type': 'Place', name: 'Veracruz, Mexico' },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Elva Fonseca Foundation',
  url: Astro.site?.toString(),
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={enHref} />
<link rel="alternate" hreflang="es" href={esHref} />
<link rel="alternate" hreflang="x-default" href={enHref} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Elva Fonseca Foundation" />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={fullTitle} />
