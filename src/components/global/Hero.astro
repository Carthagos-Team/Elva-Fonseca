---
// Hero — Fase 2. Reutilizável em Home, About, Programs, Volunteer, Donate, Stories
// (NÃO em Contact/Thank You). Fiel ao Figma (node 3107:2478; About CTA node 3287:319).
// Card de imagem arredondado + overlay escuro; conteúdo ancorado embaixo. O Header
// (global) flutua sobreposto no topo — por isso o conteúdo é bottom-aligned.
// CTA opcional (About): buckthorn + borda woodsmoke; subcopy aceita string ou string[].

import { noOrphan } from '../../lib/typography';

interface Props {
  titleLines: readonly string[];
  subcopy?: string | readonly string[];
  image?: string;
  imageAlt?: string;
  overlay?: number; // 0–1, default 0.16 (Figma)
  cta?: { label: string; href: string };
}

const {
  titleLines,
  subcopy,
  image = '/images/hero/home.webp',
  imageAlt = '',
  overlay = 0.16,
  cta,
} = Astro.props;

const paragraphs = (subcopy == null ? [] : Array.isArray(subcopy) ? subcopy : [subcopy]).map((p) =>
  noOrphan(p, 2),
);
---

<section data-hero class="bg-surface px-4 py-6 sm:px-5">
  <div class="relative flex h-[calc(100svh-3rem)] items-end justify-center overflow-hidden rounded-2xl md:h-[42rem] lg:h-[47rem]">
    <img
      data-hero-image
      src={image}
      alt={imageAlt}
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div
      data-hero-overlay
      data-overlay-value={overlay}
      class="absolute inset-0"
      style={`background-color: rgba(0,0,0,${overlay})`}
      aria-hidden="true"
    ></div>

    <div
      class:list={[
        'relative z-10 flex flex-col items-center px-6 pb-10 text-center text-orchid lg:pb-16',
        cta ? 'gap-9' : 'gap-4',
      ]}
    >
      <div class="flex flex-col items-center gap-4">
        <h1 data-hero-headline class="font-display font-black uppercase leading-[1.05] tracking-[-0.04em] text-[2.75rem] sm:text-6xl lg:text-[6.2rem]">
          {titleLines.map((line, i) => (
            <>
              <span class:list={[line.length <= 18 && 'whitespace-nowrap']}>{line}</span>
              {i < titleLines.length - 1 && <br />}
            </>
          ))}
        </h1>

        {
          paragraphs.length > 0 && (
            <div data-hero-body class="flex max-w-[49rem] flex-col gap-4 text-base font-medium leading-relaxed tracking-[-0.02em] text-orchid/95 sm:text-lg">
              {paragraphs.map(({ head, tail }) => (
                <p class="text-pretty">
                  {head}<span class="whitespace-nowrap">{tail}</span>
                </p>
              ))}
            </div>
          )
        }
      </div>

      {
        cta && (
          <a
            data-hero-cta
            href={cta.href}
            class="hover-text inline-flex min-h-11 items-center justify-center rounded-md border-[1.5px] border-woodsmoke bg-buckthorn px-6 py-3.5 font-display font-black text-base uppercase tracking-[-0.01em] text-ink transition-[transform,filter] duration-150 ease-out hover:brightness-105 active:scale-[0.97]"
          >
            <span class="hover-text__inner">
              <span class="hover-text__label is--default" data-hover-text-el>{cta.label}</span>
              <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{cta.label}</span>
            </span>
          </a>
        )
      }
    </div>
  </div>
</section>

<script>
  import { createMotion, gsap, SplitText } from '../../lib/gsap';

  function initHero() {
    const section = document.querySelector<HTMLElement>('[data-hero]');
    if (!section) return;

    const image = section.querySelector<HTMLElement>('[data-hero-image]');
    const overlay = section.querySelector<HTMLElement>('[data-hero-overlay]');
    const headline = section.querySelector<HTMLElement>('[data-hero-headline]');
    const body = section.querySelector<HTMLElement>('[data-hero-body]');
    const cta = section.querySelector<HTMLElement>('[data-hero-cta]');
    const targetOpacity = parseFloat(overlay?.dataset.overlayValue ?? '0.16');
    const startOpacity = Math.min(targetOpacity + 0.24, 0.6);

    createMotion(section, (ctx) => {
      const revealEls = [image, overlay, headline, body, cta].filter(
        (el): el is HTMLElement => !!el,
      );

      if (ctx.reducedMotion) {
        gsap.set(revealEls, { clearProps: 'all' });
        return;
      }

      const split = headline ? SplitText.create(headline, { type: 'lines', mask: 'lines' }) : null;
      const lines = split?.lines ?? [];

      if (image) gsap.set(image, { scale: 1.12 });
      if (overlay) gsap.set(overlay, { backgroundColor: `rgba(0,0,0,${startOpacity})` });
      if (lines.length) gsap.set(lines, { yPercent: 110 });
      if (body) gsap.set(body, { autoAlpha: 0, y: 16 });
      if (cta) gsap.set(cta, { autoAlpha: 0, y: 16 });

      const tl = gsap.timeline({ delay: 0.1 });
      if (image) tl.to(image, { scale: 1, duration: 1.4, ease: 'power3.out' }, 0);
      if (overlay) {
        tl.to(overlay, { backgroundColor: `rgba(0,0,0,${targetOpacity})`, duration: 1.2, ease: 'power2.out' }, 0);
      }
      if (lines.length) {
        tl.to(lines, { yPercent: 0, duration: 0.9, ease: 'power4.inOut', stagger: 0.08 }, 0.25);
      }
      if (body) tl.to(body, { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power3.out' }, 0.55);
      if (cta) tl.to(cta, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, 0.7);

      return () => {
        tl.kill();
        split?.revert();
        gsap.set(revealEls, { clearProps: 'all' });
      };
    });
  }

  if (document.readyState !== 'loading') initHero();
  else document.addEventListener('DOMContentLoaded', initHero);
</script>
