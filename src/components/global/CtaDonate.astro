---
// CtaDonate — Fase 2/3. Banda de CTA (fundo Punch) que repete acima do footer / na Home.
// Fiel ao Figma "cta-donate" (node 3104:2462). Conteúdo via props; default = donate.
//
// Fileira de flores = elementos DOM individuais (classe .cta-petal), prontas para o
// reveal em stagger com GSAP ScrollTrigger na FASE 5 (ver src/lib/gsap.ts / createMotion).

import { splitNoOrphan, protectCopy } from '../../lib/typography';

interface Props {
  titleLines?: readonly string[];
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  titleLines = ['Donate or sponsor and', 'keep the mission alive.'],
  body = "Whether you're making a personal donation or supporting as a sponsor, you're not just offering resources. You're joining a story built on care, courage, and transformation. Every contribution, big or small, helps this mission grow and reach more lives, one generous act at a time.",
  ctaLabel = 'Donate now',
  ctaHref = '/donate',
} = Astro.props;

const titleParts = titleLines.map((line, i) =>
  i === titleLines.length - 1 ? splitNoOrphan(line, 2) : { head: '', tail: line, nowrap: false },
);
const bodyText = protectCopy(body, 3);

// Ordem exata do Figma para a fileira de flores.
const row = ['02', '06', '04', '01', '07', '05', '03'];
---

<section
  data-cta-band="donate"
  data-cta-donate
  class="flex flex-col items-center bg-brand px-6 pb-16 pt-12 text-center text-orchid sm:px-10 lg:px-16"
>
  <div class="flex flex-col items-center gap-12">
    {/* Fileira de flores (decorativa). Cada .cta-petal é individual → stagger na Fase 5. */}
    <div class="flex w-full max-w-[44.25rem] items-center justify-center" aria-hidden="true">
      {
        row.map((tex) => (
          <img
            src={`/images/cta/flower-${tex}.webp`}
            alt=""
            loading="lazy"
            decoding="async"
            class="cta-petal h-auto w-full min-w-0 flex-1"
            data-reveal="petal"
          />
        ))
      }
    </div>

    {/* Texto + botão */}
    <div data-cta-donate-content class="flex flex-col items-center gap-9 px-4">
      <div class="flex flex-col items-center gap-6">
        <h2 class="max-w-full text-pretty break-normal font-display font-black text-[2.25rem] uppercase leading-[1.05] tracking-[-0.04em] sm:text-5xl lg:text-[4rem]">
          {titleParts.map((part, i) => (
            <>
              {i > 0 && <br class="hidden sm:block" />}
              {i > 0 && ' '}
              {part.head}
              {part.nowrap ? <span class="whitespace-nowrap">{part.tail}</span> : part.tail}
            </>
          ))}
        </h2>
        <p class="max-w-[34.375rem] text-pretty text-base font-medium leading-relaxed tracking-[-0.01em] text-orchid/90">{bodyText}</p>
      </div>

      <a
        href={ctaHref}
        class="hover-text inline-flex min-h-11 items-center justify-center rounded-md border-[1.5px] border-woodsmoke bg-orchid px-6 py-3.5 font-display font-black text-base uppercase tracking-[-0.01em] text-ink transition-transform duration-150 ease-out active:scale-[0.97]"
      >
        <span class="hover-text__inner">
          <span class="hover-text__label is--default" data-hover-text-el>{ctaLabel}</span>
          <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{ctaLabel}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import { createMotion, gsap } from '../../lib/gsap';

  function initCtaDonate() {
    const section = document.querySelector<HTMLElement>('[data-cta-donate]');
    if (!section) return;
    const petals = Array.from(section.querySelectorAll<HTMLElement>('[data-reveal="petal"]'));
    const content = section.querySelector<HTMLElement>('[data-cta-donate-content]');

    createMotion(section, (ctx) => {
      if (ctx.reducedMotion) {
        gsap.set(petals, { clearProps: 'all' });
        if (content) gsap.set(content, { clearProps: 'all' });
        return;
      }

      const petalsTween = gsap.from(petals, {
        autoAlpha: 0,
        y: 16,
        scale: 0.9,
        duration: 0.5,
        ease: 'back.out(1.6)',
        stagger: 0.05,
        scrollTrigger: { trigger: section, start: 'top 70%', once: true },
      });

      const contentTween = content
        ? gsap.from(content.children, {
            y: 24,
            autoAlpha: 0,
            duration: 0.6,
            ease: 'power3.out',
            stagger: 0.12,
            scrollTrigger: { trigger: section, start: 'top 65%', once: true },
          })
        : null;

      return () => {
        [petalsTween, contentTween].forEach((t) => {
          t?.scrollTrigger?.kill();
          t?.kill();
        });
        gsap.set(petals, { clearProps: 'all' });
        if (content) gsap.set(content.children, { clearProps: 'all' });
      };
    });
  }

  if (document.readyState !== 'loading') initCtaDonate();
  else document.addEventListener('DOMContentLoaded', initCtaDonate);
</script>
