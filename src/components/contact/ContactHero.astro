---
// Contact / ContactHero — Hero-form (fiel ao Figma node 3196:1129, base 1440).
// Variante de hero exclusiva de Contact: grid 2 colunas (foto + formulário), fundo orchid-100.
// Envio via Web3Forms (100% estático, sem backend — honra a regra #5). A access key é pública
// (pode ir no HTML) e vem de PUBLIC_WEB3FORMS_KEY (.env). Sem a key o form renderiza mas o envio
// falha — gerar grátis em web3forms.com colando o e-mail de destino. Subject = FAQ.

import { defaultLang, useTranslations, type Lang } from '../../i18n/utils';
import { splitNoOrphan, protectCopy } from '../../lib/typography';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang).contact.hero;
const prefix = lang === defaultLang ? '' : `/${lang}`;

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const thankYouUrl = new URL(`${prefix}/thank-you`, Astro.site).toString();

const interests = t.interests;
const heading = splitNoOrphan(t.heading, 2);

const fieldWrap = 'flex flex-col gap-2';
const label = 'font-sans text-base font-medium tracking-[-0.02em] text-ink/80';
const control =
  'w-full border-0 border-b border-woodsmoke/20 bg-transparent py-2.5 font-sans text-base text-ink placeholder-ink/40 transition-colors outline-none focus:border-punch';
---

<section data-reveal-section data-contact-hero class="border-t border-woodsmoke/10 bg-orchid-100">
  <div class="mx-auto grid max-w-[120rem] grid-cols-1 gap-12 px-6 py-16 sm:px-10 lg:grid-cols-2 lg:items-stretch lg:gap-x-12 lg:px-16 lg:py-20">
    {/* Coluna esquerda — foto */}
    <div data-contact-hero-photo class="relative aspect-[4/5] overflow-hidden rounded-md border-[1.5px] border-woodsmoke bg-orchid-050 lg:aspect-auto lg:h-full lg:min-h-[32rem]">
      <img
        src="/images/contact/hero.webp"
        alt={t.photoAlt}
        width="1267"
        height="1335"
        class="absolute inset-0 size-full object-cover"
        loading="eager"
        decoding="async"
      />
    </div>

    {/* Coluna direita — header + formulário */}
    <div data-contact-hero-content class="flex min-w-0 flex-col justify-center gap-10">
      <div class="flex flex-col gap-6">
        <img src="/images/faq/flower.webp" alt="" width="160" height="152" class="h-16 w-auto self-start" aria-hidden="true" />
        <div class="flex flex-col gap-4">
          <h2 class="max-w-full text-pretty break-normal font-display font-black uppercase leading-[1.05] tracking-[-0.04em] text-ink text-[2rem] sm:text-[2.5rem] lg:text-5xl">
            {heading.head}
            {heading.nowrap ? <span class="whitespace-nowrap">{heading.tail}</span> : heading.tail}
          </h2>
          <p class="max-w-[34rem] text-pretty font-sans text-base font-medium leading-relaxed tracking-[-0.02em] text-ink/80">
            {protectCopy(t.body, 3)}
          </p>
        </div>
      </div>

      <form action="https://api.web3forms.com/submit" method="POST" class="flex flex-col gap-9">
        {/* Web3Forms — campos de controle */}
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="New contact message — Elva Fonseca Foundation" />
        <input type="hidden" name="from_name" value="Elva Fonseca Website" />
        <input type="hidden" name="redirect" value={thankYouUrl} />
        {/* Honeypot anti-spam (deve ficar vazio) */}
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="flex flex-col gap-6">
          <div class={fieldWrap}>
            <label for="first_name" class={label}>{t.firstNameLabel}</label>
            <input id="first_name" name="first_name" type="text" autocomplete="given-name" required class={control} />
          </div>

          <div class={fieldWrap}>
            <label for="last_name" class={label}>{t.lastNameLabel}</label>
            <input id="last_name" name="last_name" type="text" autocomplete="family-name" required class={control} />
          </div>

          <div class={fieldWrap}>
            <label for="email" class={label}>{t.emailLabel}</label>
            <input id="email" name="email" type="email" autocomplete="email" required class={control} />
          </div>

          <div class={fieldWrap}>
            <label for="interest" class={label}>{t.interestLabel}</label>
            <div class="relative">
              <select id="interest" name="interest" required class={`${control} appearance-none pr-8 text-ink/60 valid:text-ink`}>
                <option value="" disabled selected>{t.selectPlaceholder}</option>
                {interests.map((opt) => <option value={opt}>{opt}</option>)}
              </select>
              <svg
                class="pointer-events-none absolute right-1 top-1/2 size-5 -translate-y-1/2 text-ink"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </div>
          </div>
        </div>

        <button
          type="submit"
          class="hover-text inline-flex min-h-11 w-fit items-center justify-center rounded-md border-[1.5px] border-woodsmoke bg-buckthorn px-6 py-3.5 font-display font-black text-base uppercase tracking-[-0.01em] text-ink transition-[transform,filter] duration-150 ease-out hover:brightness-105 active:scale-[0.97]"
        >
          <span class="hover-text__inner">
            <span class="hover-text__label is--default" data-hover-text-el>{t.sendLabel}</span>
            <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{t.sendLabel}</span>
          </span>
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  import { createMotion, gsap } from '../../lib/gsap';

  function initContactHero() {
    const section = document.querySelector<HTMLElement>('[data-contact-hero]');
    if (!section) return;
    const slots = [
      section.querySelector<HTMLElement>('[data-contact-hero-photo]'),
      section.querySelector<HTMLElement>('[data-contact-hero-content]'),
    ].filter((el): el is HTMLElement => !!el);
    if (!slots.length) return;

    createMotion(section, (ctx) => {
      if (ctx.reducedMotion) {
        gsap.set(slots, { clearProps: 'all' });
        return;
      }

      const tween = gsap.from(slots, {
        y: 24,
        autoAlpha: 0,
        duration: 0.6,
        ease: 'power3.out',
        stagger: 0.12,
        scrollTrigger: { trigger: section, start: 'top 65%', once: true },
      });

      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        gsap.set(slots, { clearProps: 'all' });
      };
    });
  }

  if (document.readyState !== 'loading') initContactHero();
  else document.addEventListener('DOMContentLoaded', initContactHero);
</script>
