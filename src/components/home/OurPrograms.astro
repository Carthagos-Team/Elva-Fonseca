---
// Home / OurPrograms — Fase 3, seção a seção. Fiel ao Figma (node 3426:149).
// Paleta de categoria confirmada aqui (docs/DESIGN_TOKENS.md previa a tabela pastel↔tinta, o
// mapeamento categoria↔cor ficava em aberto). Figma usa text-ink uniforme nos 5 cards (não a
// tinta pareada da doc) — sigo o Figma literal; contraste ink-sobre-pastel passa com folga.
// Fotos próprias de cada categoria exportadas do Figma e otimizadas em WebP.

import { defaultLang, useTranslations, type Lang } from '../../i18n/utils';
import ProgramModalGroup from './ProgramModalGroup.astro';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const btnBase =
  'inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-md border-[1.5px] border-woodsmoke bg-buckthorn px-6 py-3.5 font-display font-black text-base uppercase tracking-[-0.01em] text-ink transition-[transform,filter] duration-150 ease-out hover:brightness-105 active:scale-[0.97]';

const programs = t.home.ourPrograms.items;
const prefix = lang === defaultLang ? '' : `/${lang}`;
---

<section data-reveal-section data-our-programs class="border-t border-orchid-200 bg-orchid-100">
  <div class="mx-auto flex max-w-[120rem] flex-col items-center gap-10 px-6 py-16 text-center sm:px-10 lg:px-16">
    <div data-programs-heading class="flex flex-col items-center gap-6">
      <img src="/images/cta/rose.svg" alt="" class="h-16 w-auto" aria-hidden="true" />
      <h2 class="font-display font-black uppercase leading-[1.05] tracking-[-0.04em] text-ink text-[2.5rem] sm:text-6xl lg:text-[4rem]">
        {t.home.ourPrograms.heading}
      </h2>
      <a href={`${prefix}/donate`} class={`hover-text ${btnBase}`}>
        <span class="hover-text__inner">
          <span class="hover-text__label is--default" data-hover-text-el>{t.home.ourPrograms.ctaLabel}</span>
          <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{t.home.ourPrograms.ctaLabel}</span>
        </span>
      </a>
    </div>

    <ul class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        programs.map(({ key, bg, image, imageAlt, titleLines, description }) => (
          <li class={`rounded-lg border-[1.5px] border-woodsmoke sm:h-104 lg:h-120 ${bg}`}>
            <button
              type="button"
              data-modal-target={key}
              data-modal-status="not-active"
              class="program-card__button group flex w-full cursor-pointer flex-col bg-transparent p-2 text-inherit transition-transform duration-150 ease-out active:scale-[0.99] sm:size-full"
            >
              <div class="relative aspect-video w-full flex-none overflow-hidden rounded-md border-[1.5px] border-woodsmoke bg-orchid-100 sm:aspect-auto sm:min-h-0 sm:flex-1">
                <img
                  src={image}
                  alt={imageAlt}
                  class="program-card__image absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="flex shrink-0 flex-col gap-6 px-4 py-9 text-center">
                <span class="font-display font-black leading-[1.05] tracking-[-0.04em] text-ink text-[2rem]">
                  {
                    titleLines.map((line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ))
                  }
                </span>
                <span class="min-h-11 font-sans text-base font-medium leading-[1.4] tracking-[-0.02em] text-ink/80">
                  {description}
                </span>
              </div>
            </button>
          </li>
        ))
      }

      {/* 6º card — foto full-bleed + CTA sobreposto */}
      <li class="flex h-88 flex-col rounded-lg border-[1.5px] border-woodsmoke bg-orchid-050 p-2 sm:h-104 lg:h-120">
        <div class="relative flex-1 overflow-hidden rounded-md border-[1.5px] border-woodsmoke">
          <img
            src="/images/programs/explore.webp"
            alt={t.home.ourPrograms.exploreImageAlt}
            width="1066"
            height="1600"
            class="absolute inset-0 h-full w-full object-cover object-top"
            loading="lazy"
            decoding="async"
          />
          <a
            href={`${prefix}/programs`}
            class="hover-text absolute bottom-4 left-4 inline-flex min-h-9 items-center justify-center whitespace-nowrap rounded-md border-[1.5px] border-woodsmoke bg-buckthorn px-4 py-3 font-display font-black text-sm uppercase tracking-[-0.01em] text-ink transition-[transform,filter] duration-150 ease-out hover:brightness-105 active:scale-[0.97]"
          >
            <span class="hover-text__inner">
              <span class="hover-text__label is--default" data-hover-text-el>{t.home.ourPrograms.exploreLabel}</span>
              <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{t.home.ourPrograms.exploreLabel}</span>
            </span>
          </a>
        </div>
      </li>
    </ul>

    <ProgramModalGroup programs={programs} closeLabel={t.home.ourPrograms.closeLabel} />
  </div>
</section>

<style>
  .program-card__image {
    transition:
      transform 0.25s ease-out,
      filter 0.25s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .program-card__button:hover {
      filter: brightness(1.02);
    }

    .program-card__button:hover .program-card__image {
      filter: brightness(1.03) saturate(1.04);
      transform: scale(1.025);
    }
  }

  .program-card__button:focus-visible .program-card__image {
    filter: brightness(1.03) saturate(1.04);
    transform: scale(1.025);
  }

  @media (prefers-reduced-motion: reduce) {
    .program-card__button,
    .program-card__image {
      transition: none;
    }

    .program-card__button:hover .program-card__image,
    .program-card__button:focus-visible .program-card__image {
      transform: none;
    }
  }
</style>

<script>
  import { createMotion, gsap } from '../../lib/gsap';

  function initOurPrograms() {
    const section = document.querySelector<HTMLElement>('[data-our-programs]');
    if (!section) return;
    const heading = section.querySelector<HTMLElement>('[data-programs-heading]');
    const cards = Array.from(section.querySelectorAll<HTMLElement>('li'));

    createMotion(section, (ctx) => {
      if (ctx.reducedMotion) {
        if (heading) gsap.set(heading, { clearProps: 'all' });
        gsap.set(cards, { clearProps: 'all' });
        return;
      }

      const headingTween = heading
        ? gsap.from(heading, {
            y: 24,
            autoAlpha: 0,
            duration: 0.6,
            ease: 'power3.out',
            scrollTrigger: { trigger: section, start: 'top 65%', once: true },
          })
        : null;

      const cardsTween = gsap.from(cards, {
        y: 56,
        autoAlpha: 0,
        rotate: -3,
        scale: 0.96,
        transformOrigin: '50% 100%',
        duration: 0.6,
        ease: 'back.out(1.7)',
        stagger: 0.15,
        scrollTrigger: { trigger: section, start: 'top 65%', once: true },
      });

      return () => {
        headingTween?.scrollTrigger?.kill();
        headingTween?.kill();
        cardsTween.scrollTrigger?.kill();
        cardsTween.kill();
        if (heading) gsap.set(heading, { clearProps: 'all' });
        gsap.set(cards, { clearProps: 'all' });
      };
    });
  }

  if (document.readyState !== 'loading') initOurPrograms();
  else document.addEventListener('DOMContentLoaded', initOurPrograms);
</script>
