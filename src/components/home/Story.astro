---
// Home / Story ("About Us") — Fase 3, seção a seção. Fiel ao Figma (node 3129:121).
// Também Donate / Sponsorship (node 3315:18816) via props de conteúdo + imagePosition.
// Faixa full-bleed: imagem no topo + bloco de texto em 2 colunas (headline esq. / corpo+CTA dir.).
// Motion leve fica para o passo de review; por ora estática (hook data-reveal-section reservado).

interface Props {
  eyebrow?: string;
  titleLines?: readonly string[];
  body?: string;
  image?: string;
  imageAlt?: string;
  /** object-position CSS (ex.: "50% 18%") — default center preserva o crop da Home. */
  imagePosition?: string;
  cta?: { label: string; href: string };
}

const {
  eyebrow = 'About us',
  titleLines = ['Rooted in love,', 'grown through action.'],
  body = 'The Elva Fonseca Foundation was born from one woman’s strength, compassion, and commitment to her community. What started with small, selfless acts continues today as a legacy of care and opportunity for those who need it most.',
  image = '/images/about/story.webp',
  imageAlt = 'Members of the community greeting each other at a shared meal',
  imagePosition = 'center',
  cta = { label: 'Discover our story', href: '/about' },
} = Astro.props;
---

<section data-reveal-section data-home-story class="border-y border-orchid-200 bg-orchid-025">
  <div data-story-photo class="h-[20rem] w-full overflow-hidden sm:h-[26rem] lg:h-[34rem]">
    <img
      src={image}
      alt={imageAlt}
      width="1600"
      height="544"
      class="h-full w-full object-cover"
      style={`object-position: ${imagePosition}`}
      loading="lazy"
      decoding="async"
    />
  </div>

  {/* Figma Donate 3315:18819: flex Fill × Hug, gap 208, colunas 582 / 535 (space-between). */}
  <div class="mx-auto flex w-full max-w-[120rem] flex-col gap-8 px-6 pb-12 pt-9 sm:px-10 lg:flex-row lg:items-start lg:justify-between lg:gap-[13rem] lg:px-16">
    <div data-story-heading class="flex w-full max-w-[36.375rem] shrink-0 flex-col gap-3">
      <p class="font-sans text-sm font-semibold uppercase tracking-[0.08em] text-ink">
        {eyebrow}
      </p>
      <h2 class="font-display font-black uppercase leading-none tracking-[-0.04em] text-ink text-[2.5rem] sm:text-5xl lg:text-[3.5rem]">
        {
          titleLines.map((line, i) => (
            <>
              {line}
              {i < titleLines.length - 1 && <br />}
            </>
          ))
        }
      </h2>
    </div>

    <div data-story-body class="flex w-full max-w-[33.4375rem] shrink-0 flex-col items-start gap-6">
      <p class="text-base font-medium leading-relaxed tracking-[-0.02em] text-ink/85">
        {body}
      </p>
      <a
        href={cta.href}
        class="hover-text inline-flex min-h-11 items-center justify-center rounded-md border-[1.5px] border-woodsmoke bg-buckthorn px-6 py-3.5 font-display font-black text-base uppercase tracking-[-0.01em] text-ink transition-[transform,filter] duration-150 ease-out hover:brightness-105 active:scale-[0.97]"
      >
        <span class="hover-text__inner">
          <span class="hover-text__label is--default" data-hover-text-el>{cta.label}</span>
          <span aria-hidden="true" class="hover-text__label is--hover" data-hover-text-el>{cta.label}</span>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import { createMotion, gsap } from '../../lib/gsap';

  function initHomeStory() {
    const section = document.querySelector<HTMLElement>('[data-home-story]');
    if (!section) return;
    const slots = [
      section.querySelector<HTMLElement>('[data-story-photo]'),
      section.querySelector<HTMLElement>('[data-story-heading]'),
      section.querySelector<HTMLElement>('[data-story-body]'),
    ].filter((el): el is HTMLElement => !!el);
    if (!slots.length) return;

    createMotion(section, (ctx) => {
      if (ctx.reducedMotion) {
        gsap.set(slots, { clearProps: 'all' });
        return;
      }

      const tween = gsap.from(slots, {
        y: 24,
        autoAlpha: 0,
        duration: 0.6,
        ease: 'power3.out',
        stagger: 0.12,
        scrollTrigger: { trigger: section, start: 'top 65%', once: true },
      });

      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        gsap.set(slots, { clearProps: 'all' });
      };
    });
  }

  if (document.readyState !== 'loading') initHomeStory();
  else document.addEventListener('DOMContentLoaded', initHomeStory);
</script>
