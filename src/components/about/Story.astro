---
// About / Story — Fase 3. Fiel ao Figma "SEC 05" (node 3288:337, base 1440).
// Foto panorâmica full-bleed + 2 parágrafos à esquerda + 7 motifs geométricos à direita.
// id="story" ancora o CTA "Learn more" do Hero. Estático (sem motion) neste passo.

import { defaultLang, useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang).about.story;

const paragraphs = t.paragraphs;

const motifs = [
  { src: '/images/about/motifs/01.svg', w: 37, h: 36 },
  { src: '/images/about/motifs/02.svg', w: 40, h: 41 },
  { src: '/images/about/motifs/03.svg', w: 39, h: 39 },
  { src: '/images/about/motifs/04.svg', w: 40, h: 39 },
  { src: '/images/about/motifs/05.svg', w: 35, h: 40 },
  { src: '/images/about/motifs/06.svg', w: 40, h: 41 },
  { src: '/images/about/motifs/07.svg', w: 40, h: 40 },
] as const;
---

<section id="story" data-reveal-section data-about-story class="border-y border-orchid-200 bg-orchid-025">
  <div data-story-photo class="h-[22rem] w-full overflow-hidden sm:h-[28rem] lg:h-[34rem]">
    <img
      src="/images/about/story.webp"
      alt={t.photoAlt}
      width="2882"
      height="1088"
      class="size-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div
    class="mx-auto flex max-w-[120rem] flex-col gap-10 px-6 pb-12 pt-10 sm:px-10 lg:flex-row lg:items-start lg:justify-between lg:gap-16 lg:px-16 lg:pt-10"
  >
    <div data-story-heading class="flex max-w-[40rem] flex-col gap-4 font-sans text-base font-medium leading-[1.4] tracking-[-0.02em] text-ink">
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <div data-story-body class="flex shrink-0 flex-wrap items-center gap-3 lg:justify-end" aria-hidden="true">
      {
        motifs.map((m) => (
          <img src={m.src} alt="" width={m.w} height={m.h} class="h-10 w-auto" loading="lazy" decoding="async" />
        ))
      }
    </div>
  </div>
</section>

<script>
  import { createMotion, gsap } from '../../lib/gsap';

  function initAboutStory() {
    const section = document.querySelector<HTMLElement>('[data-about-story]');
    if (!section) return;
    const slots = [
      section.querySelector<HTMLElement>('[data-story-photo]'),
      section.querySelector<HTMLElement>('[data-story-heading]'),
      section.querySelector<HTMLElement>('[data-story-body]'),
    ].filter((el): el is HTMLElement => !!el);
    if (!slots.length) return;

    createMotion(section, (ctx) => {
      if (ctx.reducedMotion) {
        gsap.set(slots, { clearProps: 'all' });
        return;
      }

      const tween = gsap.from(slots, {
        y: 24,
        autoAlpha: 0,
        duration: 0.6,
        ease: 'power3.out',
        stagger: 0.12,
        scrollTrigger: { trigger: section, start: 'top 65%', once: true },
      });

      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        gsap.set(slots, { clearProps: 'all' });
      };
    });
  }

  if (document.readyState !== 'loading') initAboutStory();
  else document.addEventListener('DOMContentLoaded', initAboutStory);
</script>
