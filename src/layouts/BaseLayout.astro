---
import '../styles/global.css';
import SEO from '../components/global/SEO.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import DonateModal from '../components/global/DonateModal.astro';
import { defaultLang, type Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  headerTheme?: 'light' | 'dark';
  headerBackground?: 'transparent' | 'solid';
}

const {
  lang = defaultLang,
  title,
  description,
  ogImage,
  noindex,
  headerTheme = 'dark',
  headerBackground = 'transparent',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO lang={lang} {title} {description} {ogImage} {noindex} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header lang={lang} theme={headerTheme} background={headerBackground} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <DonateModal lang={lang} />
    <script>
      import { initSmoothScroll } from '../lib/scroll';
      import { initHoverText } from '../lib/hover-text';

      initSmoothScroll();
      initHoverText();
    </script>
  </body>
</html>
